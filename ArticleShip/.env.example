# ── Core LLM (required) ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Optional alternate LLM providers supported by services/llm_client.py.
# Not required unless a service's LLM_PROVIDER constant is switched away from "gemini".
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# ── MongoDB (required — auth, articles, jobs, batches, style model all use this) ──
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/
MONGODB_DB_NAME=ArticleShip
MONGODB_COLLECTION=articles
MONGODB_JOBS_COLLECTION=jobs
MONGODB_BATCHES_COLLECTION=batches

# ── Auth (required) ──────────────────────────────────────────────────────────
# Must be set to a long random secret in any non-local environment — signing
# JWTs with the insecure fallback value lets anyone forge access tokens.
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# Comma-separated extra CORS origins allowed in addition to localhost:3000-3002
# (e.g. your production frontend URL).
ALLOWED_ORIGINS=https://your-frontend-domain.example

# ── Images ────────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_SEARCH_CX=your_google_custom_search_engine_id
POLLEN_API_KEY=

# ── Search grounding (services/search/*) ─────────────────────────────────────
# Not currently wired into the live keyword/structure/article pipeline (which
# uses DuckDuckGo directly via ddgs) — only used by app.py / test scripts today.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
DISABLE_SEARCH_GROUNDING=false
