# ── Core LLM (required) ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Optional alternate LLM providers supported by services/llm_client.py.
# Not required unless a service's LLM_PROVIDER constant is switched away from "gemini".
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# ── LLM fallback chain (optional) ────────────────────────────────────────────
# Every LLM call that fails with a transient error (429/5xx) after retries
# walks this chain in order: OpenRouter -> NVIDIA -> Qwen. Each provider is
# active only if its API key is set. Verify each with:
#   GET /api/v1/llm-test?provider=qwen|openrouter|nvidia
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # mainland-China keys only
OPENROUTER_MODEL=openrouter/free
NVIDIA_MODEL=moonshotai/kimi-k2.6

# ── MongoDB (required — auth, articles, jobs, batches, style model all use this) ──
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/
MONGODB_DB_NAME=ArticleShip
MONGODB_COLLECTION=articles
MONGODB_JOBS_COLLECTION=jobs
MONGODB_BATCHES_COLLECTION=batches

# ── Auth (required) ──────────────────────────────────────────────────────────
# Must be set to a long random secret in any non-local environment — signing
# JWTs with the insecure fallback value lets anyone forge access tokens.
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# Comma-separated extra CORS origins allowed in addition to localhost:3000-3002
# (e.g. your production frontend URL).
ALLOWED_ORIGINS=https://your-frontend-domain.example

# ── Email (services/email_service.py) ────────────────────────────────────────
# Works with any SMTP provider. Free options: Gmail SMTP (smtp.gmail.com:587,
# requires a Google "app password", ~500/day limit) or Brevo's free tier
# (smtp-relay.brevo.com:587, 300/day, no personal Gmail needed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# ── Images ────────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_SEARCH_CX=your_google_custom_search_engine_id

# ── Stripe billing (services/payment_service.py) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
# Base URL used to build checkout/portal success & cancel redirects.
FRONTEND_URL=http://localhost:3000

# ── Search grounding (services/search/*) ─────────────────────────────────────
# Used as the paid fallback when DuckDuckGo retrieval returns nothing in the
# keyword/structure/article pipeline, and by app.py / test scripts.
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
DISABLE_SEARCH_GROUNDING=false
