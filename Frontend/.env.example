BACKEND_BASE_URL=http://127.0.0.1:8000
# Client-side (browser) requests read this instead of BACKEND_BASE_URL — must be
# set to the same value, or client components (e.g. AuthContext) will silently
# fall back to a different default host than the server-side API routes use.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
